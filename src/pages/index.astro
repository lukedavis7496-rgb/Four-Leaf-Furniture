---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroScroll from '../components/HeroScroll.astro';
import PieceCard from '../components/PieceCard.astro';
import LearnCard from '../components/LearnCard.astro';
import { site } from '../site.config';
import { href } from '../lib/url';
import plannerPreview from '../assets/planner-preview.png';

const pieces = (await getCollection('pieces')).sort((a, b) => b.data.year - a.data.year || Number(a.data.placeholder) - Number(b.data.placeholder));
const featured = pieces.filter((p) => p.data.featured).slice(0, 3);
const forSale = pieces.filter((p) => p.data.status === 'for-sale').slice(0, 3);
const learn = (await getCollection('learn')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 2);
---

<Base overDark>
  <HeroScroll lines={['Live edge tables.', 'Built from slabs with a story.', `Made by hand in ${site.location}.`]} />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Work</p>
          <h2>Recent pieces</h2>
        </div>
        <a class="link-arrow" href={href('/work/')}>All work</a>
      </div>
      <div class="grid">
        {featured.map((piece) => <PieceCard piece={piece} />)}
      </div>
    </div>
  </section>

  {
    forSale.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">Shop</p>
              <h2>Available now</h2>
              <p class="lede">One-of-a-kind pieces, ready for a home. Ask about any of them.</p>
            </div>
            <a class="link-arrow" href={href('/shop/')}>Shop</a>
          </div>
          <div class="grid">
            {forSale.map((piece) => <PieceCard piece={piece} showPrice />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="section planner-teaser">
    <div class="wrap planner-teaser__grid">
      <div class="stack">
        <p class="eyebrow">Free tool</p>
        <h2>Plan your own build.</h2>
        <p class="lede">
          Enter a size, a wood and a joint, and the planner works out the rest: a 3D model, a cut list with every piece lettered, the lumber to
          buy, and the order to put it together. For live edge slabs it shows where the legs go so chairs fit.
        </p>
        <p><a class="btn" href={href('/planner/')}>Open the planner</a></p>
      </div>
      <Image src={plannerPreview} alt="The planner showing a live edge table on steel legs with chairs around it." widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 560px" class="planner-teaser__img" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Learn</p>
          <h2>Getting started</h2>
          <p class="lede">What I've learned building these, written down so your first table goes smoother than mine.</p>
        </div>
        <a class="link-arrow" href={href('/learn/')}>Articles &amp; videos</a>
      </div>
      <div class="grid">
        {learn.map((entry) => <LearnCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap--narrow cta-band__inner">
      <h2>Have a slab, a space, or an idea?</h2>
      <p class="lede">Custom tables are built to your size and your room. Tell me what you have in mind.</p>
      <p><a class="btn" href={href('/inquire/')}>Start an inquiry</a></p>
    </div>
  </section>
</Base>

<style>
  .planner-teaser__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-7);
    align-items: center;
  }
  .planner-teaser__grid :global(.planner-teaser__img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .cta-band__inner {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
  }
  @media (max-width: 900px) {
    .planner-teaser__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
