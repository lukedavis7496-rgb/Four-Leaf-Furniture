---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import { href } from '../../lib/url';
import { TAG_LABELS } from '../../lib/labels';

export async function getStaticPaths() {
  const entries = await getCollection('learn');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const cover = await getImage({ src: d.cover, width: 1200 });
const date = d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title={d.title} description={d.summary} image={cover.src}>
  <article class="entry">
    <header class="wrap--narrow entry__head">
      <a class="back" href={href('/learn/')}>← Learn</a>
      <p class="eyebrow">{d.kind === 'video' ? 'Video' : 'Article'} · <time datetime={d.date.toISOString()}>{date}</time></p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <div class="entry__tags">{d.tags.map((t) => <span class="chip">{TAG_LABELS[t]}</span>)}</div>
    </header>
    <div class="wrap entry__media">
      {d.kind === 'video' ? <LiteYouTube id={d.youtubeId} title={d.title} poster={cover.src} /> : <Image src={d.cover} alt={d.coverAlt} widths={[800, 1200, 1800]} sizes="(max-width: 1200px) 100vw, 1200px" />}
    </div>
    <div class="wrap--narrow prose entry__body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .entry__head {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7) var(--space-6);
  }
  .back {
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .entry__head h1 {
    font-size: var(--step-4);
  }
  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .entry__media :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  .entry__body {
    padding-block: var(--space-7) 0;
  }
</style>
