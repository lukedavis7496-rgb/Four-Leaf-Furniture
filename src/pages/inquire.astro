---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../site.config';

const pieces = (await getCollection('pieces')).filter((p) => !p.data.placeholder || p.data.status === 'for-sale');
const connected = Boolean(site.formEndpoint);
---

<Base title="Inquire" description="Commission a custom live edge table or ask about a piece from Four Leaf Furniture.">
  <PageHead eyebrow="Inquire" title="Let's build something." lede="A custom table, a piece from the shop, or just a question: it all starts here. I'll reply within a few days." />

  <section class="wrap inquire">
    <aside class="process">
      <h2>How commissions work</h2>
      <ol>
        <li><strong>Tell me what you're after.</strong> Size, room, the feel you want, and a rough budget.</li>
        <li><strong>We design it together.</strong> I'll suggest slabs and bases, and send a 3D sketch from the planner so you can see it before anything is cut.</li>
        <li><strong>Deposit and build.</strong> A deposit reserves the slab and your spot. <span class="placeholder-note">TODO: your deposit</span></li>
        <li><strong>Delivery.</strong> Pickup or delivery once it's finished and cured.</li>
      </ol>
      <dl class="facts">
        <div><dt>Lead time</dt><dd>TODO: e.g. 4–8 weeks</dd></div>
        <div><dt>Custom tables from</dt><dd>TODO: your starting price</dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      </dl>
    </aside>

    <form class="form" method="POST" action={site.formEndpoint || '#'} data-form data-connected={connected ? 'true' : 'false'} data-email={site.email}>
      {
        !connected && (
          <p class="form__setup">
            <span class="placeholder-note">Form not connected yet</span> Add your Formspree endpoint to <code>src/site.config.ts</code>. Until then, sending opens an email instead.
          </p>
        )
      }
      <fieldset class="form__type">
        <legend>What's this about?</legend>
        <label><input type="radio" name="type" value="custom" checked /> A custom piece</label>
        <label><input type="radio" name="type" value="buy" /> Buying a listed piece</label>
        <label><input type="radio" name="type" value="question" /> A question</label>
      </fieldset>
      <div class="form__row">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
      </div>
      <label
        >Piece you're asking about
        <select name="piece" data-piece>
          <option value="">None / not sure</option>
          {pieces.map((p) => <option value={p.id}>{p.data.title}</option>)}
        </select>
      </label>
      <div class="form__row" data-custom-only>
        <label>Rough size<input name="size" placeholder="e.g. 84″ × 40″, seats 6" /></label>
        <label
          >Budget
          <select name="budget">
            <option value="">Prefer to discuss</option>
            <option>Under $1,000</option>
            <option>$1,000–2,500</option>
            <option>$2,500–5,000</option>
            <option>$5,000+</option>
          </select>
        </label>
      </div>
      <label data-custom-only
        >Timeline
        <select name="timeline">
          <option value="">Flexible</option>
          <option>Within a month</option>
          <option>1–3 months</option>
          <option>3+ months</option>
        </select>
      </label>
      <label>Message<textarea name="message" rows="6" required placeholder="The room, the people around it, the wood you love…"></textarea></label>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="form__trap" aria-hidden="true" />
      <div class="form__actions">
        <button class="btn" type="submit">Send inquiry</button>
        <p class="form__status" role="status" aria-live="polite" data-status></p>
      </div>
    </form>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const params = new URLSearchParams(location.search);

  // Pre-fill from a piece's "Inquire" button: ?piece=<slug>&type=buy|custom
  const piece = params.get('piece');
  if (piece) form.querySelector<HTMLSelectElement>('[data-piece]')!.value = piece;
  const type = params.get('type');
  if (type) form.querySelector<HTMLInputElement>(`input[name="type"][value="${CSS.escape(type)}"]`)?.click();

  // Size, budget and timeline only matter for custom work.
  const syncType = () => {
    const custom = form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value === 'custom';
    form.querySelectorAll<HTMLElement>('[data-custom-only]').forEach((el) => (el.hidden = !custom));
  };
  form.addEventListener('change', syncType);
  syncType();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get('_gotcha')) return;
    if (form.dataset.connected !== 'true') {
      // Not connected to a form service yet: hand off to the visitor's email app.
      const lines = [...data.entries()].filter(([k, v]) => k !== '_gotcha' && v).map(([k, v]) => `${k}: ${v}`);
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Inquiry from the website')}&body=${encodeURIComponent(lines.join('\n'))}`;
      status.textContent = 'Opening your email app… If nothing happens, email ' + form.dataset.email + '.';
      return;
    }
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      syncType();
      status.textContent = "Thanks — it's sent. I'll reply within a few days.";
    } catch {
      status.textContent = `That didn't send. Please try again, or email ${form.dataset.email}.`;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .inquire {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .process {
    display: grid;
    gap: var(--space-5);
  }
  .process h2 {
    font-size: var(--step-2);
  }
  .process ol {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-3);
  }
  .facts {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.9375rem;
    text-align: right;
  }
  .form {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .form label {
    display: grid;
    gap: var(--space-2);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .form label[hidden],
  .form__row[hidden] {
    display: none;
  }
  .form input:not([type='radio']),
  .form select,
  .form textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.6em 0.75em;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    font: 400 1rem / 1.4 var(--font);
  }
  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: 2px solid var(--focus);
    outline-offset: 0;
    border-color: transparent;
  }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .form__type {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .form__type legend {
    font-weight: 500;
    font-size: 0.9375rem;
    margin-bottom: var(--space-2);
  }
  .form__type label {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    padding: 0 1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 400;
    cursor: pointer;
  }
  .form__type label:has(input:checked) {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }
  .form__type input {
    accent-color: var(--accent);
  }
  .form__trap {
    position: absolute;
    left: -9999px;
  }
  .form__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .form__status {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .form__setup {
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .inquire {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .form {
      padding: var(--space-5);
    }
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
