---
/**
 * Placeholder mark: four round leaves around a centre, with a short stem.
 * Swap in your own logo SVG here and it updates the header, footer and favicon.
 */
interface Props {
  size?: number;
  label?: boolean;
}
const { size = 26, label = true } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
    <g transform="rotate(45 16 15)">
      <circle cx="11" cy="10" r="5.6"></circle>
      <circle cx="21" cy="10" r="5.6"></circle>
      <circle cx="11" cy="20" r="5.6"></circle>
      <circle cx="21" cy="20" r="5.6"></circle>
    </g>
    <path d="M16 18 C16.5 23 18.5 27 22 29.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"></path>
  </svg>
  {label && <span class="logo__word">Four Leaf<span class="logo__sub">Furniture</span></span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .logo__word {
    display: inline-flex;
    gap: 0.35em;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.0625rem;
  }
  .logo__sub {
    font-weight: 400;
    color: var(--muted);
  }
</style>
