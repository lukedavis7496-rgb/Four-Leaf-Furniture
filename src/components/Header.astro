---
import Logo from './Logo.astro';
import { href, isActive } from '../lib/url';

interface Props {
  /** Over the black home hero: light text, transparent until scrolled past. */
  overDark?: boolean;
}
const { overDark = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { path: '/work/', label: 'Work' },
  { path: '/shop/', label: 'Shop' },
  { path: '/learn/', label: 'Learn' },
  { path: '/planner/', label: 'Planner' },
  { path: '/about/', label: 'About' },
];
---

<header class:list={['site-header', { 'site-header--overlay site-header--dark': overDark }]} data-header>
  <div class="site-header__inner wrap">
    <a href={href('/')} class="site-header__home" aria-label="Four Leaf Furniture, home">
      <Logo />
    </a>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <span aria-hidden="true" class="burger"><span></span><span></span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main" data-nav>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={href(l.path)} aria-current={isActive(path, l.path) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={href('/inquire/')} class="btn site-nav__cta">Inquire</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('nav-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('is-open')) toggle.click();
  });
  // Solid background once the page scrolls; on the home page, stay dark
  // until the hero has scrolled away.
  const hero = document.querySelector('[data-hero]');
  const update = () => {
    header.classList.toggle('is-scrolled', window.scrollY > 8);
    if (hero) header.classList.toggle('site-header--dark', hero.getBoundingClientRect().bottom > 64);
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>

<style>
  .site-header {
    --header-bg: color-mix(in srgb, var(--paper) 82%, transparent);
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s,
      color 0.3s;
  }
  /* The frosted glass sits on its own layer: a backdrop-filter on the header
     itself would make Safari size the fixed mobile menu to the header bar. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    transition: background 0.3s;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }
  /* Home page: floats over the hero instead of taking up space. */
  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto;
  }
  .site-header--dark {
    color: var(--night-ink);
    --header-bg: color-mix(in srgb, var(--night) 55%, transparent);
    border-bottom-color: transparent !important;
    --muted: var(--night-muted);
  }
  .site-header--dark .site-nav__cta {
    background: var(--night-ink);
    border-color: var(--night-ink);
    color: var(--night);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .site-header__home {
    text-decoration: none;
    color: inherit;
  }
  .site-header__home:hover {
    color: inherit;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .site-nav ul {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav ul a {
    text-decoration: none;
    font-size: 0.9375rem;
    color: inherit;
    opacity: 0.8;
  }
  .site-nav ul a:hover,
  .site-nav ul a[aria-current='page'] {
    opacity: 1;
  }
  .site-nav ul a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.5em;
  }
  .site-nav__cta {
    min-height: 38px;
    padding: 0.5em 1.1em;
    font-size: 0.9375rem;
  }
  .site-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .burger {
    display: grid;
    gap: 6px;
    width: 22px;
    margin: auto;
  }
  .burger span {
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s;
  }
  .is-open .burger span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .is-open .burger span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .site-header__toggle {
      display: block;
    }
    /* The open menu is always a solid light sheet, header included, so it
       reads clearly over the black hero and in dark mode alike. */
    .site-header.is-open {
      --paper: #fbfaf8;
      --ink: #161513;
      --line: #e7e4de;
      --muted: #6e6a63;
      --accent: #2e5b44;
      --accent-ink: #ffffff;
      --header-bg: var(--paper);
      color: var(--ink);
      border-bottom-color: var(--line) !important;
    }
    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
      padding: var(--space-6) var(--gutter);
      background: var(--paper);
      color: var(--ink);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.2s,
        transform 0.2s,
        visibility 0.2s;
    }
    .is-open .site-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .site-nav ul a {
      display: block;
      padding: var(--space-4) 0;
      font-size: var(--step-2);
      font-weight: 500;
      opacity: 1;
      border-bottom: 1px solid var(--line);
    }
    .site-header--dark .site-nav__cta {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--paper);
    }
  }
</style>
