---
/**
 * A YouTube player that only loads YouTube when it's clicked, so pages with
 * videos stay fast and don't set third-party cookies until someone plays one.
 */
interface Props {
  id?: string;
  title: string;
  poster: string;
}
const { id, title, poster } = Astro.props;
---

{
  id ? (
    <div class="yt" data-yt={id} style={`background-image:url(https://i.ytimg.com/vi/${id}/hqdefault.jpg)`}>
      <button type="button" class="yt__play" aria-label={`Play video: ${title}`}>
        <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
          <path d="M66.5 7.7A8.5 8.5 0 0 0 60.5 1.7C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6c5.2 1.4 26.5 1.4 26.5 1.4s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6c1.4-5.2 1.4-16.3 1.4-16.3s0-11.1-1.4-16.3z" fill="#111" fill-opacity=".85" />
          <path d="M45 24 27 14v20z" fill="#fff" />
        </svg>
      </button>
    </div>
  ) : (
    <div class="yt yt--empty" style={`background-image:url(${poster})`}>
      <span class="placeholder-note">Video coming: add its YouTube ID</span>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = el.querySelector('button')?.getAttribute('aria-label') ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: #111 center / cover no-repeat;
  }
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .yt__play:hover path:first-child {
    fill: #c00;
    fill-opacity: 1;
  }
  .yt--empty {
    display: grid;
    place-items: center;
  }
</style>
